# Enable only after DNS, a dedicated certificate, and authentication verification.
limit_req_zone $binary_remote_addr zone=zeekr_requests:1m rate=10r/s;
server {
    listen 80;
    server_name zeekr.rocstarrobotics.com;
    location /.well-known/acme-challenge/ { root /var/www/zeekr-acme; }
    location / { return 301 https://zeekr.rocstarrobotics.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name zeekr.rocstarrobotics.com;
    ssl_certificate /etc/letsencrypt/live/zeekr.rocstarrobotics.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zeekr.rocstarrobotics.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4k;
    client_body_timeout 10s;
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_req zone=zeekr_requests burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:18765;
        proxy_set_header Host zeekr.rocstarrobotics.com;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}
