[Unit]
Description=Zeekr daily weekly monthly WeCom reports
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=zeekr-control
Group=zeekr-control
WorkingDirectory=/opt/zeekr-control/current
Environment=HOME=/var/lib/zeekr-control
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m zeekr_control.periodic_schedule
Restart=on-failure
RestartSec=60
TimeoutStopSec=90
UMask=0077
StateDirectory=zeekr-control
StateDirectoryMode=0700
MemoryMax=128M
CPUQuota=15%
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
