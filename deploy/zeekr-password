#!/usr/bin/env bash
# Run on the server. Passwords are read from the terminal, never arguments.
set -euo pipefail
if [[ "${EUID}" -ne 0 ]]; then
    exec sudo -- "$0" "$@"
fi
if [[ ! -t 0 ]]; then
    echo '请在交互终端运行；远程连接请使用 ssh -t。' >&2
    exit 1
fi
cd /opt/zeekr-control/current
sudo -u zeekr-control /usr/bin/python3 - <<'PY'
import getpass
import sys
from pathlib import Path
from zeekr_control.auth import password_record
from zeekr_control.storage import save

try:
    print('修改车辆网页密码，不修改 SSH 或极氪账号密码。')
    print('成功后重启极氪服务，所有网页登录失效，采集需重新开启。')
    first = getpass.getpass('新密码（16–256 个字符，输入不显示）：')
    second = getpass.getpass('再次输入：')
    if not 16 <= len(first) <= 256:
        raise ValueError('密码需为 16–256 个字符。')
    if first != second:
        raise ValueError('两次密码不一致。')
    save(Path('/var/lib/zeekr-control/web-auth.json'), password_record(first))
except (KeyboardInterrupt, EOFError):
    print('\n已取消，未重启服务。', file=sys.stderr)
    sys.exit(1)
except ValueError as exc:
    print(str(exc) + ' 未修改密码。', file=sys.stderr)
    sys.exit(1)
print('密码哈希已更新。')
PY
if ! systemctl restart zeekr-control; then
    echo '密码文件已更新，但服务重启失败。请运行 sudo systemctl status zeekr-control 排查。' >&2
    exit 1
fi
systemctl is-active --quiet zeekr-control
echo '已重启极氪服务。请用新密码登录、刷新车辆，再重新开启采集。'
echo '本机旧密码文件不会自动更新；官网未做修改。'
