[Unit]
Description=Zeekr private vehicle dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=zeekr-control
Group=zeekr-control
WorkingDirectory=/opt/zeekr-control/current
Environment=HOME=/var/lib/zeekr-control
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=ZEEKR_AUTH_FILE=/var/lib/zeekr-control/web-auth.json
ExecStart=/usr/bin/python3 -m zeekr_control web --port 18765
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
StateDirectory=zeekr-control
StateDirectoryMode=0700
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
CPUQuota=25%
TasksMax=64
Nice=10
IOWeight=10
LimitFSIZE=512M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
